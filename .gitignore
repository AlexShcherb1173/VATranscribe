
---

# 3. `.gitignore`

```gitignore
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.python-version

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
dist/
build/
*.egg-info/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Environment
.env

# Alembic generated files cache
alembic/__pycache__/

# Storage runtime files
storage/downloads/audio/*
storage/downloads/video/*
storage/uploads/*
storage/temp/*
storage/transcripts/txt/*
storage/transcripts/srt/*
storage/transcripts/vtt/*
storage/transcripts/json/*
storage/logs/*

# Keep folder placeholders
!storage/downloads/audio/.gitkeep
!storage/downloads/video/.gitkeep
!storage/uploads/.gitkeep
!storage/temp/.gitkeep
!storage/transcripts/txt/.gitkeep
!storage/transcripts/srt/.gitkeep
!storage/transcripts/vtt/.gitkeep
!storage/transcripts/json/.gitkeep
!storage/logs/.gitkeep