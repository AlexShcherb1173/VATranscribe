APP_NAME=VATranscribe
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/vatranscribe
REDIS_URL=redis://redis:6379/0

STORAGE_ROOT=./storage
UPLOADS_DIR=./storage/uploads
DOWNLOADS_AUDIO_DIR=./storage/downloads/audio
DOWNLOADS_VIDEO_DIR=./storage/downloads/video
TRANSCRIPTS_TXT_DIR=./storage/transcripts/txt
TRANSCRIPTS_SRT_DIR=./storage/transcripts/srt
TRANSCRIPTS_VTT_DIR=./storage/transcripts/vtt
TRANSCRIPTS_JSON_DIR=./storage/transcripts/json
TEMP_DIR=./storage/temp
LOGS_DIR=./storage/logs

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YT_DLP_PATH=yt-dlp

DEFAULT_LANGUAGE=ru
DEFAULT_TRANSCRIPTION_MODEL=small

JWT_SECRET_KEY=change_me
JWT_ACCESS_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000